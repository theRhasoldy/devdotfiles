{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true
  },
  "formatter": true,
  "lsp": true,
  "mcp": {
    "lean-ctx": {
      "command": [
        "/home/rhasoldy/.local/bin/lean-ctx"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "permission": {
    "bash": "deny",
    "edit": "ask",
    "glob": "deny",
    "grep": "deny",
    "read": "deny"
  },
  "shell": "/bin/fish",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  }
}