{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "agents": {
    "title": {
      "model": "opencode-go/deepseek-v4.1-flash"
    },
    "plan": {
      "model": "opencode-go/mimo-v2.6-pro"
    },
    "compaction": {
      "model": "opencode-go/mimo-v2.6-pro"
    }
  },
  "compaction": {
    "keep": {
      "tokens": 64000
    },
    "buffer": 16000
  },
  "experimental": {
    "background_compaction": true
  },
  "tool_output": {
    "max_lines": 500,
    "max_bytes": 131072
  },
  "formatter": true,
  "lsp": true,
  "mcp": {
    "servers": {
      "lean-ctx": {
        "command": [
          "/home/rhasoldy/.local/bin/lean-ctx"
        ],
        "type": "local"
      },
      "plane": {
        "type": "remote",
        "url": "https://mcp.plane.so/http/mcp"
      },
      "figma": {
        "type": "remote",
        "url": "https://mcp.figma.com/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*.env",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "mv *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "cp *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "sed -i*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "rm * /tmp/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm -r /tmp/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rm -rf /tmp/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "mv * /tmp/*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cp * /tmp/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "deepseek-v4-pro": {
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-5.3": {
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "glm-5.3-flash": {
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "kimi-k3.1-pro": {
          "limit": {
            "context": 200000,
            "output": 131072
          }
        },
        "mimo-v2.6-pro": {
          "limit": {
            "context": 200000,
            "output": 131072
          }
        }
      }
    }
  },
  "shell": "/bin/fish",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**"
    ]
  },
  "plugins": [
    [
      "opencode-auto-permissions",
      {
        "shadow": true
      }
    ]
  ]
}